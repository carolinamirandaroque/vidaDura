generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConnectionStatus {
  pending
  accepted
  rejected
}

enum CalendarRole {
  owner
  editor
  viewer
}

enum RecurrenceType {
  none
  daily
  weekly
  monthly
  yearly
}

enum ParticipantStatus {
  pending
  accepted
  declined
}

enum TaskStatus {
  todo
  doing
  done
}

enum TaskPriority {
  low
  medium
  high
}

enum NotificationType {
  event_invite
  expense_added
  connection_request
  task_shared
  calendar_invite
  general
}

enum HubEventType {
  social
  corporate
  cultural
  entertainment
  sports
  educational
  technological
  charitable
  religious
  other
}

enum EventKind {
  appointment
  deadline
}

enum DeadlineStatus {
  pending
  done
}

enum EventItemType {
  buy
  bring
  reminder
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  password     String?
  avatar       String?
  timezone     String   @default("Europe/Lisbon")
  googleId     String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens       RefreshToken[]
  sentConnections     Connection[]       @relation("SentConnections")
  receivedConnections Connection[]       @relation("ReceivedConnections")
  ownedCalendars      Calendar[]         @relation("CalendarOwner")
  calendarMemberships CalendarMember[]
  createdEvents       Event[]            @relation("EventCreator")
  eventParticipations EventParticipant[]
  eventDismissals     EventDismissal[]
  tasks               Task[]             @relation("TaskOwner")
  assignedTasks       Task[]             @relation("TaskAssignee")
  createdExpenses     Expense[]          @relation("ExpenseCreator")
  paidExpenses        Expense[]          @relation("ExpensePayer")
  expenseShares       ExpenseShare[]
  notifications       Notification[]
  assignedEventItems  EventItem[]
  shoppingListItems          ShoppingListItem[]
  shoppingSections           ShoppingSection[]
  shoppingSectionMemberships ShoppingSectionMember[]

  @@index([email])
  @@map("users")
}

enum ShoppingSectionRole {
  editor
  viewer
}

model ShoppingSection {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members ShoppingSectionMember[]
  items   ShoppingListItem[]

  @@unique([ownerId, name])
  @@index([ownerId])
  @@map("shopping_sections")
}

model ShoppingSectionMember {
  id        String              @id @default(cuid())
  sectionId String
  userId    String
  role      ShoppingSectionRole @default(editor)
  createdAt DateTime            @default(now())

  section ShoppingSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sectionId, userId])
  @@index([userId])
  @@map("shopping_section_members")
}

model ShoppingListItem {
  id          String    @id @default(cuid())
  ownerId     String
  sectionId   String?
  eventItemId String?   @unique
  title       String
  done        Boolean   @default(false)
  boughtAt    DateTime?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner     User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  section   ShoppingSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  eventItem EventItem?       @relation(fields: [eventItemId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([ownerId, done])
  @@index([sectionId])
  @@index([eventItemId])
  @@map("shopping_list_items")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model Connection {
  id          String           @id @default(cuid())
  requesterId String
  receiverId  String
  status      ConnectionStatus @default(pending)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("SentConnections", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  User @relation("ReceivedConnections", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@index([requesterId])
  @@index([receiverId])
  @@index([status])
  @@map("connections")
}

model Calendar {
  id          String   @id @default(cuid())
  name        String
  color       String   @default("#6366f1")
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User             @relation("CalendarOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members CalendarMember[]
  events  Event[]

  @@index([ownerId])
  @@map("calendars")
}

model CalendarMember {
  id         String       @id @default(cuid())
  calendarId String
  userId     String
  role       CalendarRole @default(viewer)
  createdAt  DateTime     @default(now())

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([calendarId, userId])
  @@index([calendarId])
  @@index([userId])
  @@map("calendar_members")
}

model Event {
  id             String          @id @default(cuid())
  calendarId     String
  kind           EventKind       @default(appointment)
  type           HubEventType    @default(social)
  title          String
  description    String?
  location       String?
  startDate      DateTime
  endDate        DateTime
  allDay         Boolean         @default(false)
  recurrence     RecurrenceType  @default(none)
  recurrenceEnd  DateTime?
  deadlineStatus DeadlineStatus?
  completedAt    DateTime?
  createdById    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  calendar     Calendar           @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  createdBy    User               @relation("EventCreator", fields: [createdById], references: [id], onDelete: Cascade)
  participants EventParticipant[]
  dismissals   EventDismissal[]
  tasks        Task[]
  expenses     Expense[]
  items        EventItem[]

  @@index([calendarId])
  @@index([createdById])
  @@index([startDate])
  @@index([endDate])
  @@index([type])
  @@map("events")
}

model EventItem {
  id          String        @id @default(cuid())
  eventId     String
  title       String
  description String?
  type        EventItemType @default(reminder)
  done        Boolean       @default(false)
  assigneeId  String?
  position    Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  event            Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignee         User?             @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  shoppingListItem ShoppingListItem?

  @@index([eventId])
  @@index([assigneeId])
  @@map("event_items")
}

model EventParticipant {
  id        String            @id @default(cuid())
  eventId   String
  userId    String
  status    ParticipantStatus @default(pending)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_participants")
}

model EventDismissal {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_dismissals")
}

model Task {
  id           String       @id @default(cuid())
  eventId      String?
  parentTaskId String?
  ownerId      String
  assigneeId   String?
  title        String
  description  String?
  status       TaskStatus   @default(todo)
  priority     TaskPriority @default(medium)
  dueDate      DateTime?
  position     Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  event    Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  owner    User   @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  assignee User?  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  parent   Task?  @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: Cascade)
  children Task[] @relation("TaskHierarchy")

  @@index([eventId])
  @@index([ownerId])
  @@index([assigneeId])
  @@index([parentTaskId])
  @@index([status])
  @@index([priority])
  @@map("tasks")
}

model Expense {
  id          String    @id @default(cuid())
  eventId     String?
  creatorId   String
  paidById    String
  settled     Boolean   @default(false)
  settledAt   DateTime?
  title       String
  description String?
  amount      Float
  currency    String    @default("EUR")
  date        DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  event   Event?         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  creator User           @relation("ExpenseCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  paidBy  User           @relation("ExpensePayer", fields: [paidById], references: [id], onDelete: Cascade)
  shares  ExpenseShare[]

  @@index([eventId])
  @@index([creatorId])
  @@index([paidById])
  @@index([settled])
  @@index([date])
  @@map("expenses")
}

model ExpenseShare {
  id         String    @id @default(cuid())
  expenseId  String
  userId     String
  amountOwed Float
  settled    Boolean   @default(false)
  settledAt  DateTime?

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
  @@index([expenseId])
  @@index([userId])
  @@index([settled])
  @@map("expense_shares")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}
